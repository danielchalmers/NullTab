{
  "manifest_version": 3,
  "name": "Null Tab",
  "short_name": "Null Tab",
  "description": "Blank new tab page for focus and speed. Minimal, distraction-free, theme-aware.",
  "version": "1.0.0",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/null-tab-16.png",
    "32": "icons/null-tab-32.png",
    "48": "icons/null-tab-48.png",
    "128": "icons/null-tab-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "null-tab@null.tab",
      "strict_min_version": "109.0"
    }
  }
}
